rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Citizen Complaints: Publicly readable and reportable
    match /complaints/{complaintId} {
      allow read: if true;
      allow create: if request.resource.data.description is string;
      allow update: if true;
      allow delete: if false;
    }

    // 2. User Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. System collection fallback
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}

